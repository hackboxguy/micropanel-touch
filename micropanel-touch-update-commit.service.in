[Unit]
Description=Commit a healthy MicroPanel Touch tryboot candidate
Wants=data.mount micropanel-touch.service micropanel-touch-privileged.service
After=data.mount micropanel-touch.service micropanel-touch-privileged.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/micropanel-touch-update-commit
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
