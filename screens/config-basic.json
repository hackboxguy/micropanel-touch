{
  "theme": "dark",
  "root": {
    "layout": "grid",
    "columns": 2
  },
  "modules": [
    {
      "id": "network_menu",
      "title": "Network",
      "icon": "network",
      "enabled": true,
      "type": "menu",
      "layout": "list",
      "accent": "#2f7ea3",
      "submenus": [
        {"id": "netinfo", "title": "Info", "icon": "info"},
        {"id": "netsettings", "title": "IP Settings", "icon": "settings"},
        {"id": "wifi", "title": "WiFi", "icon": "wifi", "color": "#3d9bf0"},
        {"id": "back", "title": "Back"}
      ]
    },
    {
      "id": "display_menu",
      "title": "Display",
      "icon": "display",
      "enabled": true,
      "type": "menu",
      "layout": "grid",
      "columns": 2,
      "accent": "#675ca8",
      "submenus": [
        {"id": "brightness", "title": "Brightness"},
        {"id": "theme_select", "title": "Theme"},
        {"id": "orientation_select", "title": "Orientation"},
        {"id": "back", "title": "Back"}
      ]
    },
    {
      "id": "system_menu",
      "title": "System",
      "icon": "system",
      "enabled": true,
      "type": "menu",
      "layout": "list",
      "accent": "#397c63",
      "submenus": [
        {"id": "system", "title": "System Stats"},
        {"id": "cpu_load", "title": "CPU Load"},
        {"id": "progress_demo", "title": "Progress Demo"},
        {"id": "back", "title": "Back"}
      ]
    },
    {
      "id": "netinfo",
      "title": "Network Info",
      "enabled": false
    },
    {
      "id": "netsettings",
      "title": "IP Settings",
      "enabled": false,
      "depends": {
        "action_script": "$MICROPANEL_HOME/usr/bin/dhcp-net-settings.sh",
        "os_type": "pios",
        "iface_name": "eth0"
      }
    },
    {
      "id": "wifi",
      "title": "WiFi Settings",
      "enabled": false
    },
    {
      "id": "brightness",
      "title": "Brightness",
      "enabled": false
    },
    {
      "id": "system",
      "title": "System Stats",
      "enabled": false
    },
    {
      "id": "cpu_load",
      "title": "CPU Load",
      "enabled": false,
      "type": "textbox",
      "depends": {
        "script_path": "$MICROPANEL_HOME/usr/bin/cpu-load-info.sh",
        "refresh_sec": "2.0",
        "display_title": "CPU Load"
      }
    },
    {
      "id": "progress_demo",
      "title": "Progress Demo",
      "enabled": false
    },
    {
      "id": "theme_select",
      "title": "Theme",
      "enabled": false
    },
    {
      "id": "orientation_select",
      "title": "Orientation",
      "enabled": false
    }
  ]
}
