{
  "theme": "dark",
  "root": {
    "layout": "grid",
    "columns": 2
  },
  "power": {
    "display_sleep_sec": 60
  },
  "modules": [
    {
      "id": "network_menu",
      "title": "Network",
      "icon": "network",
      "enabled": true,
      "type": "menu",
      "layout": "list",
      "accent": "#2f7ea3",
      "submenus": [
        {"id": "netinfo", "title": "Info", "icon": "info"},
        {"id": "netsettings", "title": "IP Settings", "icon": "settings"},
        {"id": "wifi", "title": "WiFi", "icon": "wifi"},
        {"id": "wifi_password_demo", "title": "Wi-Fi Password", "icon": "wifi"},
        {"id": "back", "title": "Back"}
      ]
    },
    {
      "id": "display_menu",
      "title": "Display",
      "icon": "display",
      "enabled": true,
      "type": "menu",
      "layout": "grid",
      "columns": 2,
      "rows": 3,
      "accent": "#675ca8",
      "submenus": [
        {"id": "brightness", "title": "Brightness", "icon": "brightness"},
        {"id": "display_standby", "title": "Standby", "icon": "standby"},
        {"id": "theme_select", "title": "Theme", "icon": "theme"},
        {"id": "orientation_select", "title": "Orientation", "icon": "orientation"},
        {"id": "back", "title": "Back", "icon": "back"}
      ]
    },
    {
      "id": "system_menu",
      "title": "System",
      "icon": "system",
      "enabled": true,
      "type": "menu",
      "layout": "list",
      "accent": "#397c63",
      "submenus": [
        {"id": "system", "title": "System Stats"},
        {"id": "software_update", "title": "Software Update", "icon": "system"},
        {"id": "screen_lock", "title": "Screen Lock", "icon": "lock"},
        {"id": "touch_calibration", "title": "Touch Calibration", "icon": "settings"},
        {"id": "cpu_load", "title": "CPU Load"},
        {"id": "progress_demo", "title": "Progress Demo"},
        {"id": "action_runner_demo", "title": "Action Runner Demo"},
        {"id": "slider_demo", "title": "Slider Demo"},
        {"id": "back", "title": "Back"}
      ]
    },
    {
