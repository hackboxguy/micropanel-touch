[Unit]
Description=MicroPanel Touch HMI

[Service]
Type=simple
User=@MICROPANEL_TOUCH_SERVICE_USER@
SupplementaryGroups=video input render
ExecStart=@CMAKE_INSTALL_PREFIX@/usr/bin/micropanel-touch @SYSTEMD_UNITFILE_ARGS@
Restart=on-failure
RestartSec=2
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
