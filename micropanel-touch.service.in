[Unit]
Description=MicroPanel Touch HMI
Wants=micropanel-touch-privileged.service data.mount
# sdm-firstboot is present only on images created by the build pipeline and
# writes a final console status line on its one physical boot.  Start the HMI
# afterwards so it owns the panel framebuffer last; the ordering is inert on
# later boots once that one-shot service has disabled itself.
After=micropanel-touch-privileged.service data.mount sdm-firstboot.service

[Service]
Type=simple
User=@MICROPANEL_TOUCH_SERVICE_USER@
SupplementaryGroups=video input render
RuntimeDirectory=micropanel-touch-ui
RuntimeDirectoryMode=0700
ExecStart=@CMAKE_INSTALL_PREFIX@/usr/bin/micropanel-touch --privileged-broker-socket @MICROPANEL_TOUCH_BROKER_SOCKET@ --static-ip-interface @MICROPANEL_TOUCH_STATIC_IP_INTERFACE@ --data-dir @MICROPANEL_TOUCH_DATA_DIR@ --fallback-data-dir @MICROPANEL_TOUCH_FALLBACK_DATA_DIR@ --runtime-dir @MICROPANEL_TOUCH_RUNTIME_DIR@ @SYSTEMD_UNITFILE_ARGS@
Restart=on-failure
RestartSec=2
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
