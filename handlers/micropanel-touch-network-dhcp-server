#!/bin/sh
# Invoked only by the root-owned broker after strict typed-request and peer
# validation.  This is an isolated Ethernet provisioning mode: it assigns the
# panel a static eth0 address and starts the dedicated dnsmasq unit.  It never
# configures forwarding, NAT, an upstream router, or a DNS service.
set -eu

if [ "$#" -ne 5 ]; then
    printf '%s\n' '[ERROR] DHCP server handler requires interface address prefix lease-start lease-end' >&2
    exit 64
fi

interface=$1
address=$2
prefix=$3
lease_start=$4
lease_end=$5
state_root=/data/micropanel-touch-network
state_dir=$state_root/dhcp-server
settings_file=$state_dir/settings
dnsmasq_config=$state_dir/dnsmasq.conf
enabled_file=$state_dir/enabled
service=micropanel-touch-dhcp-server.service

# The image service is deliberately single-interface.  Keep this duplicate
# guard close to the side effects in case this handler is ever run outside the
# broker by an administrator.
if [ "$interface" != eth0 ]; then
    printf '%s\n' '[ERROR] DHCP server is supported only on eth0' >&2
    exit 64
fi
for ipv4 in "$address" "$lease_start" "$lease_end"; do
    case "$ipv4" in
        ''|*[!0123456789.]*|*..*)
            printf '%s\n' '[ERROR] invalid IPv4 DHCP server value' >&2
            exit 64
            ;;
    esac
done
case "$prefix" in
    ''|*[!0123456789]*)
        printf '%s\n' '[ERROR] invalid IPv4 DHCP server prefix' >&2
        exit 64
        ;;
esac

[ -x /usr/sbin/dnsmasq ] || {
    printf '%s\n' '[ERROR] dnsmasq is not installed' >&2
    exit 1
}

# The post-image hook creates this root-owned, group-readable location.  The
# UI account may inspect settings for display but cannot alter a configuration
# later consumed by this root service.
if [ ! -d "$state_dir" ] || [ ! -w "$state_dir" ]; then
    printf '%s\n' '[ERROR] DHCP server persistent state is unavailable' >&2
    exit 1
fi

umask 027
settings_tmp=$(mktemp "$state_dir/.settings.XXXXXX")
config_tmp=$(mktemp "$state_dir/.dnsmasq.conf.XXXXXX")
cleanup() {
    rm -f "$settings_tmp" "$config_tmp"
}
trap cleanup EXIT HUP INT TERM

cat > "$settings_tmp" <<EOF
interface=$interface
address=$address
prefix_length=$prefix
lease_start=$lease_start
lease_end=$lease_end
EOF
cat > "$config_tmp" <<EOF
# Generated by micropanel-touch-network-dhcp-server.  Do not edit in place.
interface=$interface
# On boot NetworkManager applies the saved static address asynchronously.  The
# dynamic binding mode lets dnsmasq start before that address exists and bind
# it once present, rather than emitting a transient bind-interfaces failure.
bind-dynamic
port=0
dhcp-range=$lease_start,$lease_end,12h
# This appliance serves an isolated provisioning link only. Explicit empty
# option values prevent dnsmasq defaults from advertising the panel as a
# default router or DNS server.
dhcp-option=option:router
dhcp-option=option:dns-server
dhcp-authoritative
# Lease continuity across panel reboots is intentionally not promised: a
# client will rediscover and obtain a lease after this volatile file resets.
dhcp-leasefile=/run/micropanel-touch-dhcp-server/dnsmasq.leases
EOF
chmod 0640 "$settings_tmp" "$config_tmp"
chown root:micropanel-touch "$settings_tmp" "$config_tmp"

if ! /usr/sbin/dnsmasq --test --conf-file="$config_tmp" >/dev/null 2>&1; then
    printf '%s\n' '[ERROR] DHCP server configuration validation failed' >&2
    exit 1
fi

# Stop the old authority before changing the address.  Removing the marker
# first also prevents the enabled boot unit from starting a stale config.
rm -f "$enabled_file"
if ! /usr/bin/systemctl stop "$service"; then
    printf '%s\n' '[ERROR] failed to stop DHCP server service' >&2
    exit 1
fi

mv -f "$settings_tmp" "$settings_file"
mv -f "$config_tmp" "$dnsmasq_config"

connection=$(/usr/bin/nmcli --terse --get-values GENERAL.CONNECTION device show "$interface")
if [ -z "$connection" ] || [ "$connection" = '--' ]; then
    printf '%s\n' '[ERROR] no active NetworkManager connection for interface' >&2
    exit 1
fi
if ! /usr/bin/nmcli --wait 15 connection modify "$connection" \
    connection.interface-name "$interface" ipv4.method manual \
    ipv4.addresses "$address/$prefix" ipv4.gateway '' ipv4.dns ''; then
    printf '%s\n' '[ERROR] failed to update NetworkManager profile' >&2
    exit 1
fi
if ! /usr/bin/nmcli --wait 20 connection up "$connection" ifname "$interface"; then
    printf '%s\n' '[ERROR] failed to activate NetworkManager profile' >&2
    exit 1
fi

touch "$enabled_file"
chmod 0640 "$enabled_file"
chown root:micropanel-touch "$enabled_file"
if ! /usr/bin/systemctl restart "$service"; then
    printf '%s\n' '[ERROR] failed to start DHCP server service' >&2
    exit 1
fi
printf '%s\n' '[SUCCESS] DHCP server configuration applied'
