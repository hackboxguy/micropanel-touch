#!/bin/sh
# Network diagnostics, bound to one interface.
#
# Invoked by the unprivileged HMI, not by the broker: ping is capability-
# granted on Debian and curl needs nothing, so none of this wants root. It is
# a Tier-1 handler so the command construction lives in one auditable place
# rather than being assembled in C++.
#
# Every test binds to the interface it was given. That is the whole point of
# choosing an interface first: this panel routinely holds an address on two
# links at once, and an unbound test silently measures whichever one the route
# table prefers and reports it as the answer.
set -eu

usage() {
    printf '%s\n' '[ERROR] net test handler requires a test and an interface' >&2
    exit 64
}

[ "$#" -ge 2 ] || usage
test_name=$1
interface=$2
target=${3:-}
port_argument=${4:-}

case "$interface" in
    ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-]*) usage ;;
esac
# A target is a host or address, never an option and never a shell fragment.
case "$target" in
    -*|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.:-]*) usage ;;
esac

ping=/usr/bin/ping
curl=/usr/bin/curl

# The interface's own default gateway, straight from the kernel's route table.
# The first thing to ping is the thing one hop away.
gateway_for() {
    # awk extracts the field; the shell converts it. strtonum() would be
    # shorter and is a gawk extension - this image ships mawk, where it does
    # not exist and the function silently produces nothing. Found by running
    # this on the panel; no host fixture would have noticed, because build
    # hosts tend to have gawk.
    hex=$(awk -v want="$1" '
        NR > 1 && $1 == want && $2 == "00000000" { print $3; exit }' \
        /proc/net/route 2>/dev/null)
    [ -n "$hex" ] || return 0
    # /proc/net/route holds addresses little-endian, so the octets come out
    # least-significant first.
    packed=$((0x$hex))
    printf '%d.%d.%d.%d\n' \
        $((packed % 256)) $(((packed / 256) % 256)) \
        $(((packed / 65536) % 256)) $(((packed / 16777216) % 256))
}

address_for() {
    ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4; exit}'
}

carrier_for() {
    cat "/sys/class/net/$1/carrier" 2>/dev/null || echo 0
}

case "$test_name" in
ping)
    host=$target
    if [ -z "$host" ]; then
        host=$(gateway_for "$interface")
        [ -n "$host" ] || {
            printf '%s\n' "[ERROR] $interface has no default gateway to ping" >&2
            exit 1
        }
        printf 'Pinging the gateway %s via %s\n' "$host" "$interface"
    else
        printf 'Pinging %s via %s\n' "$host" "$interface"
    fi
    # Bounded by construction: four probes, one second apart, six seconds dead.
    if "$ping" -c 4 -i 1 -w 6 -I "$interface" "$host" 2>&1; then
        printf '%s\n' '[SUCCESS] Reachable'
    else
        printf '%s\n' "[ERROR] $host did not answer on $interface" >&2
        exit 1
    fi
    ;;

internet)
    # Staged on purpose. "No internet" has several causes an admin has to tell
    # apart, and which stage failed is the diagnosis - a pass/fail verdict
    # throws away the only useful part of the answer.
    failed=''
    printf 'Carrier... '
    if [ "$(carrier_for "$interface")" = 1 ]; then printf 'up\n'; else printf 'DOWN\n'; failed=carrier; fi
    printf 'Address... '
    address=$(address_for "$interface")
    if [ -n "$address" ]; then printf '%s\n' "$address"; else printf 'none\n'; failed=${failed:-address}; fi
    printf 'Gateway... '
    gateway=$(gateway_for "$interface")
    if [ -n "$gateway" ] && "$ping" -c 1 -W 3 -I "$interface" "$gateway" >/dev/null 2>&1; then
        printf '%s ok\n' "$gateway"
    elif [ -n "$gateway" ]; then
        printf '%s unreachable\n' "$gateway"; failed=${failed:-gateway}
    else
        printf 'none\n'; failed=${failed:-gateway}
    fi
    printf 'DNS... '
    if "$curl" --interface "$interface" --max-time 8 -s -o /dev/null \
        "https://one.one.one.one/" 2>/dev/null; then
        printf 'resolves\n'
    else
        printf 'FAILED\n'; failed=${failed:-dns}
    fi
    printf 'HTTPS... '
    code=$("$curl" --interface "$interface" --max-time 10 -s -o /dev/null \
        -w '%{http_code}' "https://connectivitycheck.gstatic.com/generate_204" 2>/dev/null || echo 000)
    if [ "$code" = 204 ] || [ "$code" = 200 ]; then
        printf '%s\n' "$code"
    else
        printf 'no reply\n'; failed=${failed:-https}
    fi
    if [ -z "$failed" ]; then
        printf '%s\n' '[SUCCESS] Internet reachable'
    else
        printf '%s\n' "[ERROR] Stopped at: $failed" >&2
        exit 1
    fi
    ;;

neighbours)
    # Who else is on this segment. /proc/net/arp is the kernel's own neighbour
    # table: no scanning, no packets, nothing an IT policy could object to -
    # it lists what this interface has already talked to.
    printf 'Neighbours seen on %s\n' "$interface"
    found=$(awk -v want="$interface" '
        NR > 1 && $6 == want && $4 != "00:00:00:00:00:00" {
            printf "%-15s %s\n", $1, $4
            n++
        }
        END { exit !n }' /proc/net/arp 2>/dev/null) && {
        printf '%s\n' "$found"
        printf '%s\n' "[SUCCESS] $(printf '%s\n' "$found" | wc -l) neighbour(s)"
        exit 0
    }
    # An empty table is a fact, not a failure: a link that has spoken to
    # nothing yet looks exactly like this.
    printf '%s\n' "[ERROR] No neighbours recorded on $interface yet"
    exit 1
    ;;

port)
    [ -n "$target" ] || {
        printf '%s\n' '[ERROR] port check needs a host and a port' >&2
        exit 64
    }
    port=$port_argument
    case "$port" in
        ''|*[!0123456789]*)
            printf '%s\n' '[ERROR] port check needs a host and a port' >&2
            exit 64
            ;;
    esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || {
        printf '%s\n' '[ERROR] port check needs a host and a port' >&2
        exit 64
    }
    printf 'Connecting to %s port %s via %s\n' "$target" "$port" "$interface"
    # -z connects and closes without sending anything; -w bounds the wait. The
    # source address pins it to the interface, since nc has no -I.
    source_address=$(address_for "$interface" | cut -d/ -f1)
    [ -n "$source_address" ] || {
        printf '%s\n' "[ERROR] $interface has no address to connect from" >&2
        exit 1
    }
    if /usr/bin/nc -z -w 4 -s "$source_address" "$target" "$port" 2>&1; then
        printf '%s\n' "[SUCCESS] $target:$port is open"
    else
        printf '%s\n' "[ERROR] $target:$port did not accept a connection" >&2
        exit 1
    fi
    ;;

speed)
    url=${MICROPANEL_TOUCH_SPEED_URL:-https://cachefly.cachefly.net/50mb.test}
    scratch=${MICROPANEL_TOUCH_SPEED_SCRATCH:-/tmp/micropanel-touch-speedtest.bin}
    rm -f "$scratch" "$scratch.rate"
    printf 'Downloading via %s\n' "$interface"

    # Ask how big it is first, so progress can be a fraction rather than a
    # spinner. A server that will not say is not a failure - the download still
    # runs, it just cannot be drawn as a bar.
    total=$("$curl" --interface "$interface" --max-time 15 -sIL "$url" 2>/dev/null |
        awk 'BEGIN { IGNORECASE = 1 } /^[Cc]ontent-[Ll]ength:/ { n = $2 }
             END { gsub(/\r/, "", n); print n + 0 }')
    [ "${total:-0}" -gt 0 ] 2>/dev/null || total=0

    # curl writes its own final measurement to a file, because it runs in the
    # background where -w output would be lost.
    "$curl" --interface "$interface" --max-time 280 -s -o "$scratch" \
        -w '%{size_download} %{speed_download} %{time_total}' "$url" > "$scratch.rate" 2>/dev/null &
    curl_pid=$!
    trap 'kill "$curl_pid" 2>/dev/null || true; rm -f "$scratch" "$scratch.rate"' EXIT HUP INT TERM

    # PROGRESS lines are read by the panel and drawn as a bar; anything else on
    # this stream is shown as text. Polling the file size costs nothing and
    # needs no cooperation from curl.
    while kill -0 "$curl_pid" 2>/dev/null; do
        if [ "$total" -gt 0 ]; then
            have=$(stat -c %s "$scratch" 2>/dev/null || echo 0)
            printf 'PROGRESS %d\n' $(( have * 100 / total ))
        fi
        sleep 1
    done
    wait "$curl_pid" || {
        printf '%s\n' "[ERROR] The download did not complete on $interface" >&2
        exit 1
    }
    printf 'PROGRESS 100\n'

    summary=$(cat "$scratch.rate" 2>/dev/null)
    bytes=$(printf '%s' "$summary" | awk '{print $1}')
    rate=$(printf '%s' "$summary" | awk '{print $2}')
    seconds=$(printf '%s' "$summary" | awk '{print $3}')
    [ "${bytes:-0}" -gt 0 ] 2>/dev/null || {
        printf '%s\n' "[ERROR] The download returned nothing on $interface" >&2
        exit 1
    }
    printf 'Downloaded %s bytes in %s s\n' "$bytes" "$seconds"
    printf '%s\n' "[SUCCESS] $(awk -v r="$rate" 'BEGIN { printf "%.1f Mbit/s", r * 8 / 1000000 }')"
    ;;

iperf-discover)
    # Ask the LAN who is offering iperf3. The server half of this feature
    # publishes the same service, so two panels find each other with nobody
    # typing an address - which is the most useful thing the OLED build does
    # here and the reason avahi-utils is in the image.
    [ -x /usr/bin/avahi-browse ] || {
        printf '%s\n' '[ERROR] Service discovery is not available on this panel' >&2
        exit 1
    }
    printf 'Looking for iperf3 servers...\n'
    # Every address this panel answers to, so its own server does not come
    # back as something to test against.
    #
    # Loopback was filtered from the first version, which was not enough: a
    # panel running its own server hears the announcement again on each of its
    # LAN addresses, and dialling one of those never leaves the machine. The
    # bench panel offered itself as two separate servers - .197 and .198, one
    # host wearing both of its interfaces - and either would have reported a
    # throughput figure measuring nothing but the local stack.
    own_addresses=$(ip -4 -o addr show 2>/dev/null | awk '{ sub("/.*", "", $4); print $4 }')
    # One line per server, in a shape the panel can act on rather than only
    # print: the address and port it would dial, then the host name for the
    # person choosing between them. Discovery whose result can only be read
    # back and retyped is a worse version of typing the address.
    found=$(/usr/bin/avahi-browse -rtp _iperf3._tcp 2>/dev/null |
        awk -F';' -v own="$own_addresses" '
            BEGIN { count = split(own, list, "\n"); for (i = 1; i <= count; i++) mine[list[i]] = 1 }
            $1 == "=" && $3 == "IPv4" && $8 !~ /^127\./ && !($8 in mine) {
                printf "SERVER %s %s %s\n", $8, $9, $7 }' |
        sort -u) || found=''
    if [ -n "$found" ]; then
        printf '%s\n' "$found"
        printf '%s\n' "[SUCCESS] $(printf '%s\n' "$found" | wc -l) server(s) found"
    else
        printf '%s\n' '[ERROR] No iperf3 servers announced on this network'
        exit 1
    fi
    ;;

iperf-server)
    port=${target:-5201}
    case "$port" in
        ''|*[!0123456789]*) printf '%s\n' '[ERROR] iperf server needs a numeric port' >&2; exit 64 ;;
    esac
    [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || {
        printf '%s\n' '[ERROR] iperf server needs a port from 1024 to 65535' >&2
        exit 64
    }
    [ -x /usr/bin/iperf3 ] || {
        printf '%s\n' '[ERROR] iperf3 is not installed on this panel' >&2
        exit 1
    }
    source_address=$(address_for "$interface" | cut -d/ -f1)
    [ -n "$source_address" ] || {
        printf '%s\n' "[ERROR] $interface has no address to listen on" >&2
        exit 1
    }
    # Announced while running and unannounced when this exits, including when
    # the panel kills it: a stale advertisement is worse than none, because a
    # client finds it and then times out.
    avahi_pid=''
    iperf_pid=''
    # Both children are killed by pid rather than by relying on the signal
    # reaching the whole process group. It usually does - the panel terminates
    # a process group and escalates - but "usually" leaves an iperf3 listening
    # and an mDNS record advertising a server nobody is running, which is the
    # worst of the available outcomes.
    cleanup_server() {
        [ -n "$avahi_pid" ] && kill "$avahi_pid" 2>/dev/null
        [ -n "$iperf_pid" ] && kill "$iperf_pid" 2>/dev/null
        return 0
    }
    trap cleanup_server EXIT HUP INT TERM
    if [ -x /usr/bin/avahi-publish ]; then
        /usr/bin/avahi-publish -s "micropanel-touch on $interface" _iperf3._tcp "$port" \
            >/dev/null 2>&1 &
        avahi_pid=$!
        printf 'Announced as _iperf3._tcp on port %s\n' "$port"
    fi
    printf 'Listening on %s port %s\n' "$source_address" "$port"
    printf 'Stop returns this panel to normal.\n'
    # -1 is deliberately NOT used: the server serves until it is stopped, which
    # is what the screen's Stop button means.
    /usr/bin/iperf3 -s -B "$source_address" -p "$port" 2>&1 &
    iperf_pid=$!
    wait "$iperf_pid"
    ;;

iperf-client)
    server=$target
    port=${port_argument:-5201}
    protocol=${5:-tcp}
    duration=${6:-10}
    bandwidth=${7:-10M}
    reverse=${8:-off}
    [ -n "$server" ] || { printf '%s\n' '[ERROR] iperf client needs a server address' >&2; exit 64; }
    case "$port" in ''|*[!0123456789]*) printf '%s\n' '[ERROR] iperf client needs a numeric port' >&2; exit 64 ;; esac
    case "$protocol" in tcp|udp) ;; *) printf '%s\n' '[ERROR] iperf client protocol must be tcp or udp' >&2; exit 64 ;; esac
    case "$duration" in ''|*[!0123456789]*) printf '%s\n' '[ERROR] iperf client needs a numeric duration' >&2; exit 64 ;; esac
    # Bounded by construction. A flood with no end is a denial of service on
    # whatever shares the segment, and the panel offering one would be a fault
    # rather than a feature.
    [ "$duration" -ge 1 ] && [ "$duration" -le 60 ] || {
        printf '%s\n' '[ERROR] iperf client duration must be 1 to 60 seconds' >&2
        exit 64
    }
    case "$bandwidth" in ''|*[!0123456789KMG]*) printf '%s\n' '[ERROR] iperf client bandwidth is malformed' >&2; exit 64 ;; esac
    case "$reverse" in on|off) ;; *) printf '%s\n' '[ERROR] iperf client reverse must be on or off' >&2; exit 64 ;; esac
    [ -x /usr/bin/iperf3 ] || {
        printf '%s\n' '[ERROR] iperf3 is not installed on this panel' >&2
        exit 1
    }
    source_address=$(address_for "$interface" | cut -d/ -f1)
    [ -n "$source_address" ] || {
        printf '%s\n' "[ERROR] $interface has no address to test from" >&2
        exit 1
    }
    set -- -c "$server" -p "$port" -B "$source_address" -t "$duration" -f m
    [ "$protocol" = udp ] && set -- "$@" -u -b "$bandwidth"
    [ "$reverse" = on ] && set -- "$@" -R
    printf 'Testing %s to %s:%s for %ss via %s\n' "$protocol" "$server" "$port" "$duration" "$interface"
    if /usr/bin/iperf3 "$@" 2>&1; then
        printf '%s\n' '[SUCCESS] Test complete'
    else
        printf '%s\n' "[ERROR] The test did not complete against $server" >&2
        exit 1
    fi
    ;;

*)
    usage
    ;;
esac
