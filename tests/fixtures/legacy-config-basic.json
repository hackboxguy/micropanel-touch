          "result_pattern": "DEVICE=",
          "result_prefix": "FPGA: ",
          "usb_blaster_duration": 103,
          "parse_progress": true
        },
        {"title": "BACK"}
      ]
    },
    {"id": "builtin_status", "title": "Status", "enabled": false},
    {"id": "textbox_info", "title": "Info", "enabled": false, "type": "textbox"},
    {"id": "action_info", "title": "Action", "enabled": false, "type": "action"}
  ]
}
