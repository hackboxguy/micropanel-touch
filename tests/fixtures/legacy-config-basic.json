{
  "modules": [
    {
      "id": "root_menu",
      "title": "Root",
      "enabled": true,
      "type": "menu",
      "unknown_touch_only_key": "ignored",
      "submenus": [
        {"id": "disabled_menu", "title": "Hidden menu"},
        {"id": "flash_actions", "title": "Flash"},
        {"id": "back", "title": "Return"}
      ]
    },
    {
      "id": "disabled_menu",
      "title": "Hidden menu",
      "enabled": false,
      "type": "menu",
      "submenus": [
        {"id": "builtin_status", "title": "Status"},
        {"id": "back", "title": "Back"}
      ]
    },
    {
      "id": "flash_actions",
      "title": "Flash",
      "enabled": true,
      "type": "GenericList",
      "list_items": [
        {
          "title": "Update",
          "action": "stdbuf -oL -eL $MICROPANEL_HOME/fpga/bin/flash --image=demo",
