#!/bin/sh
# Restore a device-unique machine ID from the persistent appliance partition.
# This runs before systemd-machine-id-commit and D-Bus. The lower image keeps
# /etc/machine-id empty, so systemd supplies a transient random ID on a first
# boot; that ID is committed here to the root-owned data store.
set -eu

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

persistent_directory=${MICROPANEL_TOUCH_MACHINE_ID_PERSISTENT_DIR:-/data/micropanel-touch-system}
persistent_id=${persistent_directory}/machine-id
system_id=${MICROPANEL_TOUCH_MACHINE_ID_SYSTEM_PATH:-/etc/machine-id}
dbus_id=${MICROPANEL_TOUCH_MACHINE_ID_DBUS_PATH:-/var/lib/dbus/machine-id}

valid_machine_id() {
    [ "$#" -eq 1 ] || return 1
    printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{32}$' || return 1
    [ "$1" != 00000000000000000000000000000000 ]
}

read_machine_id() {
    [ -r "$1" ] || return 1
    value=$(cat "$1") || return 1
    valid_machine_id "$value" || return 1
    printf '%s\n' "$value"
}

if [ "${MICROPANEL_TOUCH_MACHINE_ID_ASSUME_PERSISTENT_DATA:-0}" != 1 ]; then
    mounted_target=$(findmnt -rn -T "$persistent_directory" -o TARGET 2>/dev/null || true)
    [ "$mounted_target" = /data ] || exit 0
fi

# The image finalizer creates this root-owned directory. Creating it here as
# well makes an in-place software upgrade safe for an existing /data volume.
# This system unit runs as root and /data itself is root-owned, so the
# unprivileged HMI cannot pre-create or replace this sibling of its own
# persistent directory.
install -d -m0700 "$persistent_directory"

desired_id=
if stored_id=$(read_machine_id "$persistent_id"); then
    desired_id=$stored_id
elif transient_id=$(read_machine_id "$system_id"); then
    desired_id=$transient_id
else
    desired_id=$(tr -d '-' </proc/sys/kernel/random/uuid)
    valid_machine_id "$desired_id" || exit 1
fi

if [ "$desired_id" != "${stored_id:-}" ]; then
    temporary_id=$(mktemp "$persistent_directory/.machine-id.XXXXXX") || exit 1
    if ! printf '%s\n' "$desired_id" > "$temporary_id" ||
       ! chmod 0444 "$temporary_id" || ! sync -f "$temporary_id"; then
        rm -f "$temporary_id"
        exit 1
    fi
    if ! mv -f "$temporary_id" "$persistent_id" || ! sync -f "$persistent_directory"; then
        rm -f "$temporary_id"
        exit 1
    fi
fi
chmod 0444 "$persistent_id"

# On the first boot this writes systemd's transient ID through its bind mount;
# systemd-machine-id-commit persists the same value into the overlay later.
install -m0444 "$persistent_id" "$system_id"
install -m0444 "$persistent_id" "$dbus_id"
